generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TRAVELLER
  ADMIN
}

enum PackageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  REPLIED
  CLOSED
}

enum MessageChannel {
  EMAIL
  WHATSAPP
  SYSTEM
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  phone         String?
  passwordHash  String
  role          Role     @default(TRAVELLER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enquiries         Enquiry[]       @relation("EnquirySubmitter")
  assignedEnquiries Enquiry[]       @relation("EnquiryAssignee")
  enquiryNotes      EnquiryNote[]
  enquiryReplies    EnquiryReply[]
  packageVersions   PackageVersion[]
}

model Package {
  id               String        @id @default(cuid())
  slug             String        @unique
  status           PackageStatus @default(DRAFT)
  currentVersionId String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  currentVersion PackageVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions       PackageVersion[] @relation("PackageVersions")
  seasonalPrices SeasonalPrice[]
  enquiries      Enquiry[]
}

model PackageVersion {
  id            String   @id @default(cuid())
  packageId     String
  versionNumber Int
  title         String
  destination   String
  days          Int
  description   String
  inclusions    String[]
  exclusions    String[]
  hotelTier     String
  itinerary     Json
  photos        String[]
  mapCenter     Json?
  authorId      String
  createdAt     DateTime @default(now())

  package        Package @relation("PackageVersions", fields: [packageId], references: [id], onDelete: Cascade)
  currentOf      Package? @relation("CurrentVersion")
  author         User    @relation(fields: [authorId], references: [id])

  @@index([packageId, versionNumber])
}

model SeasonalPrice {
  id              String  @id @default(cuid())
  packageId       String
  seasonName      String
  seasonStartMonth Int
  seasonEndMonth   Int
  pricePerPerson  Int
  basis           String  @default("Per person, twin sharing")
  gstInclusive    Boolean @default(true)
  isActive        Boolean @default(true)

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

model Enquiry {
  id             String        @id @default(cuid())
  packageId      String?
  userId         String?
  name           String
  email          String
  phone          String?
  message        String
  travelDates    String?
  adults         Int?
  children       Int?
  budget         String?
  status         EnquiryStatus @default(NEW)
  assignedToId   String?
  aiExtracted    Json?
  aiSuggestions  Json?
  aiDraftReply   String?
  autoAckSentAt  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  package    Package? @relation(fields: [packageId], references: [id])
  user       User?    @relation("EnquirySubmitter", fields: [userId], references: [id])
  assignedTo User?    @relation("EnquiryAssignee", fields: [assignedToId], references: [id])
  notes      EnquiryNote[]
  replies    EnquiryReply[]

  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
}

model EnquiryNote {
  id         String   @id @default(cuid())
  enquiryId  String
  authorId   String
  content    String
  createdAt  DateTime @default(now())

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])
}

model EnquiryReply {
  id        String         @id @default(cuid())
  enquiryId String
  authorId  String
  content   String
  channel   MessageChannel @default(EMAIL)
  sentAt    DateTime       @default(now())

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])
}

model PreviewCache {
  id        String   @id @default(cuid())
  token     String   @unique
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}
