generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TRAVELLER
  ADMIN
  EDITOR
  CONSULTANT
}

enum PackageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  REPLIED
  CLOSED
}

enum MessageChannel {
  EMAIL
  WHATSAPP
  SYSTEM
}

enum EnquiryChannel {
  WEB
  CHAT
  WHATSAPP
  EMAIL
  PHONE
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  phone         String?
  passwordHash  String
  role          Role     @default(TRAVELLER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enquiries         Enquiry[]       @relation("EnquirySubmitter")
  assignedEnquiries Enquiry[]       @relation("EnquiryAssignee")
  enquiryNotes      EnquiryNote[]
  enquiryReplies    EnquiryReply[]
  packageVersions   PackageVersion[]
  blogPosts         BlogPost[]
  quotes            Quote[]
  activityLogs      ActivityLog[]
}

model Package {
  id               String        @id @default(cuid())
  slug             String        @unique
  status           PackageStatus @default(DRAFT)
  currentVersionId String?       @unique
  scheduledAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  currentVersion PackageVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions       PackageVersion[] @relation("PackageVersions")
  seasonalPrices SeasonalPrice[]
  enquiries      Enquiry[]
  quotes         Quote[]
}

model PackageVersion {
  id            String   @id @default(cuid())
  packageId     String
  versionNumber Int
  title         String
  destination   String
  days          Int
  description   String
  inclusions    String[]
  exclusions    String[]
  hotelTier     String
  itinerary     Json
  photos        String[]
  mapCenter     Json?
  authorId      String
  createdAt     DateTime @default(now())

  package        Package @relation("PackageVersions", fields: [packageId], references: [id], onDelete: Cascade)
  currentOf      Package? @relation("CurrentVersion")
  author         User    @relation(fields: [authorId], references: [id])

  @@index([packageId, versionNumber])
}

model SeasonalPrice {
  id              String  @id @default(cuid())
  packageId       String
  seasonName      String
  seasonStartMonth Int
  seasonEndMonth   Int
  pricePerPerson  Int
  basis           String  @default("Per person, twin sharing")
  gstInclusive    Boolean @default(true)
  isActive        Boolean @default(true)

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

model Enquiry {
  id             String        @id @default(cuid())
  packageId      String?
  userId         String?
  name           String
  email          String
  phone          String?
  message        String
  travelDates    String?
  adults         Int?
  children       Int?
  budget         String?
  channel        EnquiryChannel @default(WEB)
  privacyConsentAt DateTime?
  whatsappConsentAt DateTime?
  status         EnquiryStatus @default(NEW)
  assignedToId   String?
  aiExtracted    Json?
  aiSuggestions  Json?
  aiDraftReply   String?
  autoAckSentAt  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  package    Package? @relation(fields: [packageId], references: [id])
  user       User?    @relation("EnquirySubmitter", fields: [userId], references: [id])
  assignedTo User?    @relation("EnquiryAssignee", fields: [assignedToId], references: [id])
  notes      EnquiryNote[]
  replies    EnquiryReply[]
  quotes     Quote[]

  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
}

model EnquiryNote {
  id         String   @id @default(cuid())
  enquiryId  String
  authorId   String
  content    String
  createdAt  DateTime @default(now())

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])
}

model EnquiryReply {
  id        String         @id @default(cuid())
  enquiryId String
  authorId  String
  content   String
  channel   MessageChannel @default(EMAIL)
  sentAt    DateTime       @default(now())

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])
}

model PreviewCache {
  id        String   @id @default(cuid())
  token     String   @unique
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  coverImage  String?
  category    String
  tags        String[]
  seoTitle    String?
  seoDescription String?
  relatedPackageIds String[]
  published   Boolean  @default(false)
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([category])
  @@index([published])
}

model Quote {
  id          String   @id @default(cuid())
  token       String   @unique
  packageId   String
  enquiryId   String?
  generatedByAI Boolean  @default(false)
  travellers  Int
  travelDate  String?
  pricePerPerson Int
  basis       String   @default("Per person, twin sharing")
  gstInclusive Boolean  @default(true)
  gstRate      Float    @default(18)
  totalPrice Int
  inclusions  String[]
  exclusions  String[]
  notes       String?
  validUntil  DateTime
  authorId    String
  createdAt   DateTime @default(now())

  package Package @relation(fields: [packageId], references: [id])
  enquiry Enquiry? @relation(fields: [enquiryId], references: [id])
  author  User    @relation(fields: [authorId], references: [id])

  @@index([token])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entity     String
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}
